NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:4173
DATA_DIR=./data
# Production: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Required in production. Share privately with invited creators.
INVITE_CODE=
MAX_FILE_MB=512
MAX_OUTPUT_MB=512
MAX_USER_STORAGE_MB=2048
MAX_PROJECT_SECONDS=1800
MAX_PROJECT_ASSETS=24
MAX_ACTIVE_JOBS=2
MAX_PROVIDER_CALLS=8
MAX_RENDERS_PER_DAY=20
RETENTION_DAYS=30
FFMPEG_THREADS=2
# Operator-only exact local AI origin; never set this from visitor input.
LOCAL_AI_ORIGIN=

# Native worker for a hosted API (keep real values in ignored .env files only).
WORKER_API_URL=http://127.0.0.1:3001
WORKER_TOKEN=
SITES_SERVICE_TOKEN=
WORKER_DATA_DIR=./data
