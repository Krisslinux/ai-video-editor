{
  "name": "ai-video-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop video editor",
  "main": "dist-main/electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node --test tests/*.test.cjs",
    "fixture": "node scripts/make-fixture.cjs",
    "verify:loop": "npm run build && npm run fixture && node scripts/verify-loop.cjs",
    "pack:win": "node scripts/check-media-bundle.cjs win32 && npm run build && electron-builder --win nsis",
    "pack:linux": "node scripts/check-media-bundle.cjs linux && npm run build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "org.aivideoeditor.desktop",
    "productName": "AI Video Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "media-tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@sentry/electron": "8.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
