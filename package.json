{
  "name": "frameflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "api": "node --env-file-if-exists=.env --import tsx server/api.ts",
    "worker": "node --env-file-if-exists=.env --import tsx server/worker.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/core.test.ts",
    "test:integration": "node --import tsx tests/integration.ts",
    "test:e2e": "playwright test",
    "fixtures": "node --import tsx scripts/fixtures.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/api.ts",
    "build:sites": "npm run build && node scripts/build-edge.mjs",
    "test:lyrics": "node --import tsx tests/lyrics.integration.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "lucide-react": "0.468.0",
    "@napi-rs/canvas": "1.0.13"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "tsx": "4.21.0",
    "vite": "8.3.5",
    "esbuild": "0.27.7"
  }
}
